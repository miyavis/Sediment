{
  "name": "sediment",
  "version": "0.1.2",
  "description": "Local-first Obsidian plugin: knowledge stats, heatmap, quick memos, weekly reviews and agent knowledge deposition.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "mcp": "node mcp-server/index.mjs",
    "test:mcp": "node scripts/mcp-smoke.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "heatmap",
    "statistics",
    "pkm",
    "mcp",
    "agent"
  ],
  "license": "MIT",
  "author": {
    "name": "miyavis",
    "email": "miyavis521@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/miyavis/Sediment.git"
  },
  "homepage": "https://github.com/miyavis/Sediment#readme",
  "devDependencies": {
    "@types/node": "^20.12.7",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "obsidian": "^1.6.0",
    "typescript": "^5.4.5"
  }
}
