{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "sediment": {
      "type": "local",
      "command": ["node", "<vault>/.obsidian/plugins/sediment/mcp-server/index.mjs"],
      "environment": {
        "SEDIMENT_URL": "http://127.0.0.1:27123",
        "SEDIMENT_TOKEN": "token from Sediment settings",
        "AGENT_NAME": "opencode"
      },
      "enabled": true
    }
  }
}
